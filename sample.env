ENV=dev

# Required. The database name comes from the URI path.
MONGO_URI=mongodb://localhost:27017/ulamonitors

# Required. Signs the JWTs. Generate with: openssl rand -hex 32
SECRET_KEY=change-me

# Required. The only user the API creates by itself; everyone else is created
# through POST /users. Generate with: openssl rand -base64 18
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me

# Tokens last a full class session (8 h)
ACCESS_TOKEN_DURATION_MINUTES=480

# Comma-separated, or "*"
CORS_ORIGINS=*

# Inserts a simulated reading per transmitting sensor every 5 minutes
ENABLE_SCHEDULER=false
